{
	"info": {
		"_postman_id": "phase1-auth-rbac-collection",
		"name": "Phase 1 - Authentication & RBAC",
		"description": "Comprehensive testing for Phase 1: Authentication, User Management, and Permission System\n\n**Prerequisites:**\n- Backend server running on {{base_url}}\n- MongoDB connected\n- Environment file imported\n\n**Test Coverage:**\n- User Registration (6 roles)\n- User Login & Token Management\n- User CRUD Operations\n- Permission Management\n- RBAC Enforcement\n\n**Expected Runtime:** ~2 minutes",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "01 - Register & Login",
			"item": [
				{
					"name": "Register Super Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Response has user data\", function () {",
									"    const response = pm.response.json();",
									"    pm.expect(response).to.have.property('success', true);",
									"    pm.expect(response.data).to.have.property('user');",
									"    pm.expect(response.data.user).to.have.property('email', 'superadmin@acero.com');",
									"    pm.expect(response.data.user).to.have.property('role', 'super_admin');",
									"});",
									"",
									"pm.test(\"Response has token\", function () {",
									"    const response = pm.response.json();",
									"    pm.expect(response.data).to.have.property('token');",
									"    pm.expect(response.data.token).to.be.a('string').and.not.empty;",
									"});",
									"",
									"pm.test(\"Password not in response\", function () {",
									"    const response = pm.response.json();",
									"    pm.expect(response.data.user).to.not.have.property('password');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
