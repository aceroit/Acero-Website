					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Image uploaded successfully\", function () {",
									"    const response = pm.response.json();",
									"    pm.expect(response.data).to.have.property('url');",
									"    pm.expect(response.data).to.have.property('publicId');",
									"    pm.expect(response.data).to.have.property('resourceType', 'image');",
									"    pm.environment.set('test_media_id', response.data._id);",
									"    pm.environment.set('test_media_public_id', response.data.publicId);",
									"});",
									"",
									"pm.test(\"Cloudinary URL returned\", function () {",
									"    const response = pm.response.json();",
									"    pm.expect(response.data.url).to.include('cloudinary');",
									"});"
								],
