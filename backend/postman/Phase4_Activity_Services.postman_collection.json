				{
					"name": "Get All Activities (Admin)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Activities array returned\", function () {",
									"    const response = pm.response.json();",
									"    pm.expect(response.data).to.be.an('array');",
									"});",
									"",
									"pm.test(\"Activity has required fields\", function () {",
									"    const response = pm.response.json();",
									"    if (response.data && response.data.length > 0) {",
									"        const activity = response.data[0];",
									"        pm.expect(activity).to.have.property('userId');",
									"        pm.expect(activity).to.have.property('action');",
									"        pm.expect(activity).to.have.property('resource');",
									"        pm.expect(activity).to.have.property('timestamp');",
									"    }",
									"});",
									"",
									"pm.test(\"Response time < 500ms\", function () {",
									"    pm.expect(pm.response.responseTime).to.be.below(500);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}"
							}
						],
