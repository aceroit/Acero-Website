		{
			"name": "02 - Permission-Based Page CRUD Restrictions",
			"item": [
				{
					"name": "Setup: Create Test Pages in Different Statuses",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"const response = pm.response.json();",
									"const title = response.data.title;",
									"if (title.includes('Draft')) {",
									"    pm.environment.set('test_page_draft_id', response.data._id);",
									"} else if (title.includes('Review')) {",
									"    pm.environment.set('test_page_in_review_id', response.data._id);",
									"} else if (title.includes('Approval')) {",
									"    pm.environment.set('test_page_pending_approval_id', response.data._id);",
									"} else if (title.includes('Changes')) {",
									"    pm.environment.set('test_page_changes_requested_id', response.data._id);",
									"} else if (title.includes('Published')) {",
									"    pm.environment.set('test_page_published_id', response.data._id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{editor_token}}"
							},
