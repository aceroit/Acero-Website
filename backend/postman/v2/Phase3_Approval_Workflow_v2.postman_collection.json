		{
			"name": "03 - Tree Management Restrictions",
			"item": [
				{
					"name": "Setup: Create Page Hierarchy",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"const response = pm.response.json();",
									"if (response.data.title.includes('Parent')) {",
									"    pm.environment.set('tree_parent_page_id', response.data._id);",
