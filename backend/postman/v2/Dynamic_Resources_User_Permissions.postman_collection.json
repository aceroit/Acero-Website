{
	"info": {
		"_postman_id": "v2-dynamic-resources-permissions",
		"name": "V2 - Dynamic Resources & User Permissions",
		"description": "Complete testing collection for Dynamic Resources and User Permissions System\n\n**Prerequisites:**\n- Empty database (fresh start)\n- Backend server running on {{base_url}}\n- MongoDB connected\n- Environment file imported\n\n**Test Flow:**\n1. Create Super Admin User\n2. Login as Super Admin\n3. Create All Resources\n4. Assign Role-Based Permissions\n5. Test User-Specific Permissions\n6. Verify Dynamic Sidebar\n\n**Expected Runtime:** ~5 minutes",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "01 - Setup: User Creation",
			"item": [
				{
					"name": "Register Super Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Super Admin created\", function () {",
									"    const response = pm.response.json();",
									"    pm.expect(response).to.have.property('success', true);",
									"    pm.expect(response.data.user).to.have.property('role', 'super_admin');",
									"    pm.expect(response.data.user).to.have.property('email', 'superadmin@acero.com');",
									"    pm.expect(response.data).to.have.property('token');",
									"    ",
									"    // Store token and user ID",
									"    pm.environment.set('super_admin_token', response.data.token);",
									"    pm.environment.set('super_admin_id', response.data.user._id);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"firstName\": \"Super\",\n  \"lastName\": \"Admin\",\n  \"email\": \"superadmin@acero.com\",\n  \"password\": \"SuperAdmin@123\",\n  \"role\": \"super_admin\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/register",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "register"]
						},
						"description": "Create the first Super Admin user. This user will have full access to create resources and manage permissions."
					},
					"response": []
				},
